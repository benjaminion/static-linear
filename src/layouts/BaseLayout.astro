---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  generatedAt?: string;
}

const { title, description = "An invite-only view of work tracked in Linear", generatedAt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav aria-label="Primary navigation">
        <a href="/">Overview</a>
        <a href="/timeline/">Projects</a>
        <a href="/people/">People</a>
        <a href="/dependencies/">Tasks</a>
        <a href="/search/">Search</a>
        <a href="/cdn-cgi/access/logout">Sign out</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Static snapshot of Linear planning data.</span>
      {generatedAt && <span>Generated <time datetime={generatedAt}>{new Date(generatedAt).toLocaleString("en-GB")}</time></span>}
    </footer>
    <script>
      import { isTaskOverdue } from "../lib/task-due-date";

      document.querySelectorAll<HTMLElement>("[data-task-due-date]").forEach((element) => {
        element.classList.toggle(
          "task-due-date--overdue",
          isTaskOverdue(element.dataset.taskDueDate, element.dataset.taskStatusType),
        );
      });
    </script>
  </body>
</html>
