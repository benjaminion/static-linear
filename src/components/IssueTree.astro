---
import type { PublicIssue, PublicSnapshot } from "../lib/schema";
import { compareIssues, compareIssuesByDueDate, issueHref, statusClass } from "../lib/view";

interface Props {
  issues: PublicIssue[];
  snapshot: PublicSnapshot;
  level?: number;
  orderBy?: "priority" | "dueDate";
}
const { issues, snapshot, level = 0, orderBy = "priority" } = Astro.props;
const compare = orderBy === "dueDate" ? compareIssuesByDueDate : compareIssues;
const orderedIssues = [...issues].sort(compare);
---

<ul class:list={["issue-tree", { "issue-tree--nested": level > 0 }]}>
  {orderedIssues.map((issue) => (
    <li>
      <div class="issue-row">
        <a class="issue-identifier" href={issueHref(issue)}>{issue.identifier}</a>
        <a class="issue-title" href={issueHref(issue)}>{issue.title}</a>
        <span class={statusClass(issue.state.type)}>{issue.state.name}</span>
        {issue.dueDate && (
          <time
            datetime={issue.dueDate}
            data-task-due-date={issue.dueDate}
            data-task-status-type={issue.state.type}
          >{issue.dueDate}</time>
        )}
      </div>
      {issue.childIds.length > 0 && (
        <Astro.self
          issues={issue.childIds.map((id) => snapshot.issues[id]).filter(Boolean)}
          snapshot={snapshot}
          level={level + 1}
          orderBy={orderBy}
        />
      )}
    </li>
  ))}
</ul>
