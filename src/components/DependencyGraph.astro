---
import type { PublicSnapshot } from "../lib/schema";
import { blockingRelations, compareDependencyIssues, dependencyCycles, initiativeProjects, issueHref, serializeForScript } from "../lib/view";

interface Props { snapshot: PublicSnapshot }
const { snapshot } = Astro.props;
const projects = initiativeProjects(snapshot);
const relations = blockingRelations(snapshot);
const endpointIds = [...new Set(relations.flatMap((relation) => [relation.sourceId, relation.targetId]))]
  .sort((a, b) => compareDependencyIssues(a, b, snapshot));
const nodes = endpointIds.map((id) => ({
  id,
  label: snapshot.issues[id]?.identifier ?? snapshot.boundaries[id]?.label ?? "Unknown",
  title: snapshot.issues[id]?.title ?? "Dependency outside this initiative",
  href: snapshot.issues[id] ? issueHref(snapshot.issues[id]) : null,
  projectId: snapshot.issues[id]?.projectId ?? null,
}));
const graphData = serializeForScript({ nodes, edges: relations.map((relation) => ({ source: relation.sourceId, target: relation.targetId })) });
const cycles = dependencyCycles(snapshot);
---

{cycles.length > 0 && (
  <aside class="alert" role="alert">
    <strong>{cycles.length} dependency cycle{cycles.length === 1 ? "" : "s"} detected.</strong>
    Review the relationships in the table below.
  </aside>
)}

<div class="graph-shell" data-graph>
  <div class="toolbar">
    <label>Project
      <select data-graph-project>
        <option value="">All projects</option>
        {projects.map((project) => <option value={project.id}>{project.name}</option>)}
      </select>
    </label>
    <button class="button button--secondary" type="button" data-reset-graph>Reset view</button>
  </div>
  <svg class="dependency-graph" viewBox="0 0 1000 600" role="img" aria-label="Blocking issue dependency graph" data-graph-svg>
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,4 L0,8 Z"></path></marker>
    </defs>
    <g data-edges></g>
    <g data-nodes></g>
  </svg>
  {relations.length === 0 && <p class="empty-state">No blocking relationships were found in this initiative.</p>}
  <script is:inline type="application/json" data-graph-data set:html={graphData}></script>
</div>

<script>
  import { layoutDependencyNodes, routeDependencyEdges } from "../lib/dependency-layout";

  interface GraphNode { id: string; label: string; title: string; href: string | null; projectId: string | null }
  interface GraphEdge { source: string; target: string }
  interface GraphData { nodes: GraphNode[]; edges: GraphEdge[] }
  function renderGraph(root: HTMLElement) {
    const dataNode = root.querySelector<HTMLScriptElement>("[data-graph-data]");
    const all = JSON.parse(dataNode?.textContent || "{}") as GraphData;
    const project = root.querySelector<HTMLSelectElement>("[data-graph-project]")?.value ?? "";
    const visibleIds = new Set<string>(
      all.nodes.filter((node) => !project || node.projectId === project).map((node) => node.id),
    );
    const edges = all.edges.filter((edge) => visibleIds.has(edge.source) || visibleIds.has(edge.target));
    for (const edge of edges) { visibleIds.add(edge.source); visibleIds.add(edge.target); }
    const nodes = all.nodes.filter((node) => visibleIds.has(node.id));
    const svg = root.querySelector<SVGSVGElement>("[data-graph-svg]");
    const nodeLayer = svg?.querySelector<SVGGElement>("[data-nodes]");
    const edgeLayer = svg?.querySelector<SVGGElement>("[data-edges]");
    if (!svg || !nodeLayer || !edgeLayer) return;
    nodeLayer.replaceChildren(); edgeLayer.replaceChildren();
    const nodeLayout = layoutDependencyNodes(nodes.map((node) => node.id), edges);
    const positions = new Map(nodeLayout.nodes.map(({ id, x, y }) => [id, { x, y }]));
    nodes.forEach((node) => {
      const { x, y } = positions.get(node.id)!;
      positions.set(node.id, { x, y });
      const link = document.createElementNS("http://www.w3.org/2000/svg", "a");
      if (node.href) link.setAttribute("href", node.href);
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", String(x)); circle.setAttribute("cy", String(y)); circle.setAttribute("r", "28");
      circle.setAttribute("class", node.href ? "graph-node" : "graph-node graph-node--boundary");
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", String(x)); text.setAttribute("y", String(y + 4)); text.setAttribute("text-anchor", "middle");
      text.textContent = node.label.length > 16 ? `${node.label.slice(0, 14)}…` : node.label;
      const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
      title.textContent = `${node.label}: ${node.title}`;
      link.append(circle, text, title); nodeLayer.append(link);
    });
    const layout = routeDependencyEdges(
      [...positions].map(([id, position]) => ({ id, ...position })),
      edges,
    );
    layout.routes.forEach((route) => {
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", route.d);
      path.setAttribute("class", "graph-edge"); path.setAttribute("marker-end", "url(#arrowhead)");
      edgeLayer.append(path);
    });
    svg.setAttribute("viewBox", `0 ${layout.minY} ${nodeLayout.width} ${layout.maxY - layout.minY}`);
  }
  document.querySelectorAll<HTMLElement>("[data-graph]").forEach((root) => {
    renderGraph(root);
    const projectFilter = root.querySelector<HTMLSelectElement>("[data-graph-project]");
    projectFilter?.addEventListener("change", () => renderGraph(root));
    root.querySelector<HTMLButtonElement>("[data-reset-graph]")?.addEventListener("click", () => {
      if (projectFilter) projectFilter.value = "";
      renderGraph(root);
    });
  });
</script>
