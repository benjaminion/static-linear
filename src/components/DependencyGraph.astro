---
import type { PublicSnapshot } from "../lib/schema";
import {
  blockingRelations,
  compareDependencyIssues,
  dependencyCycles,
  dependencyIssueDate,
  initiativeProjects,
  issueHref,
  serializeForScript,
} from "../lib/view";

interface Props { snapshot: PublicSnapshot }
const { snapshot } = Astro.props;
const projects = initiativeProjects(snapshot);
const relations = blockingRelations(snapshot);
const endpointIds = [...new Set(relations.flatMap((relation) => [relation.sourceId, relation.targetId]))]
  .sort((a, b) => compareDependencyIssues(a, b, snapshot));
const nodes = endpointIds.map((id) => ({
  id,
  label: snapshot.issues[id]?.identifier ?? snapshot.boundaries[id]?.label ?? "Unknown",
  title: snapshot.issues[id]?.title ?? "Dependency outside this initiative",
  dueDate: dependencyIssueDate(id, snapshot),
  statusType: snapshot.issues[id]?.state.type ?? null,
  href: snapshot.issues[id] ? issueHref(snapshot.issues[id]) : null,
  projectId: snapshot.issues[id]?.projectId ?? null,
}));
const graphData = serializeForScript({ nodes, edges: relations.map((relation) => ({ source: relation.sourceId, target: relation.targetId })) });
const cycles = dependencyCycles(snapshot);
---

{cycles.length > 0 && (
  <aside class="alert" role="alert">
    <strong>{cycles.length} dependency cycle{cycles.length === 1 ? "" : "s"} detected.</strong>
    Review the relationships in the table below.
  </aside>
)}

<div class="graph-shell" data-graph>
  <div class="toolbar">
    <label>Project
      <select data-graph-project>
        <option value="">All projects</option>
        {projects.map((project) => <option value={project.id}>{project.name}</option>)}
      </select>
    </label>
    <button class="graph-toggle" type="button" aria-pressed="true" data-show-done>
      <span class="graph-toggle__dot" aria-hidden="true"></span>
      <span data-done-label>Hide Done</span>
    </button>
    <button class="button button--secondary" type="button" data-reset-graph>Reset view</button>
  </div>
  <svg class="dependency-graph" viewBox="0 0 1000 600" role="img" aria-label="Blocking issue dependency graph" data-graph-svg>
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,4 L0,8 Z"></path></marker>
    </defs>
    <g data-edges></g>
    <g data-nodes></g>
    <g data-annotations></g>
  </svg>
  {relations.length === 0 && <p class="empty-state">No blocking relationships were found in this initiative.</p>}
  <script is:inline type="application/json" data-graph-data set:html={graphData}></script>
</div>

<script>
  import { layoutDependencyNodes, routeDependencyEdges } from "../lib/dependency-layout";

  interface GraphNode {
    id: string;
    label: string;
    title: string;
    dueDate: string | null;
    statusType: string | null;
    href: string | null;
    projectId: string | null;
  }
  interface GraphEdge { source: string; target: string }
  interface GraphData { nodes: GraphNode[]; edges: GraphEdge[] }

  const NODE_RADIUS = 28;
  const ANNOTATION_HEIGHT = 38;
  const ANNOTATION_GAP = 10;

  function truncateLabel(value: string, max: number): string {
    return value.length > max ? `${value.slice(0, max - 1)}…` : value;
  }

  /** Map Linear workflow type → graph fill (Todo blue, active green, Done grey). */
  function graphNodeClass(node: GraphNode): string {
    if (!node.href) return "graph-node graph-node--boundary";
    const type = (node.statusType ?? "").toLowerCase();
    if (type === "completed" || type === "canceled") return "graph-node graph-node--done";
    if (type === "started") return "graph-node graph-node--started";
    if (type === "unstarted" || type === "backlog" || type === "triage") return "graph-node graph-node--todo";
    return "graph-node graph-node--started";
  }

  function isDoneNode(node: GraphNode): boolean {
    const type = (node.statusType ?? "").toLowerCase();
    return type === "completed" || type === "canceled";
  }

  function createAnnotation(node: GraphNode, x: number, y: number): SVGGElement {
    const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
    group.setAttribute("class", "graph-annotation");
    group.setAttribute("data-annotation-for", node.id);

    const titleLine = truncateLabel(node.title, 44);
    const dateLine = node.dueDate ? `Due ${node.dueDate}` : "No date";
    const width = Math.min(240, Math.max(112, Math.max(titleLine.length, dateLine.length) * 6.1 + 18));
    const cardY = y - NODE_RADIUS - ANNOTATION_GAP - ANNOTATION_HEIGHT;
    const cardX = x - width / 2;

    const card = document.createElementNS("http://www.w3.org/2000/svg", "rect");
    card.setAttribute("class", "graph-annotation__card");
    card.setAttribute("x", String(cardX));
    card.setAttribute("y", String(cardY));
    card.setAttribute("width", String(width));
    card.setAttribute("height", String(ANNOTATION_HEIGHT));
    card.setAttribute("rx", "6");

    const titleText = document.createElementNS("http://www.w3.org/2000/svg", "text");
    titleText.setAttribute("class", "graph-annotation__title");
    titleText.setAttribute("x", String(x));
    titleText.setAttribute("y", String(cardY + 15));
    titleText.setAttribute("text-anchor", "middle");
    titleText.textContent = titleLine;

    const dateText = document.createElementNS("http://www.w3.org/2000/svg", "text");
    dateText.setAttribute("class", "graph-annotation__date");
    dateText.setAttribute("x", String(x));
    dateText.setAttribute("y", String(cardY + 29));
    dateText.setAttribute("text-anchor", "middle");
    dateText.textContent = dateLine;

    group.append(card, titleText, dateText);
    return group;
  }

  function renderGraph(root: HTMLElement) {
    const dataNode = root.querySelector<HTMLScriptElement>("[data-graph-data]");
    const all = JSON.parse(dataNode?.textContent || "{}") as GraphData;
    const project = root.querySelector<HTMLSelectElement>("[data-graph-project]")?.value ?? "";
    const showDone = root.querySelector<HTMLButtonElement>("[data-show-done]")?.getAttribute("aria-pressed") !== "false";
    const visibleIds = new Set<string>(
      all.nodes.filter((node) => !project || node.projectId === project).map((node) => node.id),
    );
    const projectEdges = all.edges.filter((edge) => visibleIds.has(edge.source) || visibleIds.has(edge.target));
    for (const edge of projectEdges) { visibleIds.add(edge.source); visibleIds.add(edge.target); }
    if (!showDone) {
      for (const node of all.nodes) {
        if (isDoneNode(node)) visibleIds.delete(node.id);
      }
    }
    const edges = projectEdges.filter((edge) => visibleIds.has(edge.source) && visibleIds.has(edge.target));
    if (!showDone) {
      const connectedIds = new Set(edges.flatMap((edge) => [edge.source, edge.target]));
      for (const id of visibleIds) {
        if (!connectedIds.has(id)) visibleIds.delete(id);
      }
    }
    const nodes = all.nodes.filter((node) => visibleIds.has(node.id));
    const svg = root.querySelector<SVGSVGElement>("[data-graph-svg]");
    const nodeLayer = svg?.querySelector<SVGGElement>("[data-nodes]");
    const edgeLayer = svg?.querySelector<SVGGElement>("[data-edges]");
    const annotationLayer = svg?.querySelector<SVGGElement>("[data-annotations]");
    if (!svg || !nodeLayer || !edgeLayer || !annotationLayer) return;
    nodeLayer.replaceChildren();
    edgeLayer.replaceChildren();
    annotationLayer.replaceChildren();
    const nodeLayout = layoutDependencyNodes(nodes.map((node) => node.id), edges);
    const positions = new Map(nodeLayout.nodes.map(({ id, x, y }) => [id, { x, y }]));
    const nodeCircles = new Map<string, SVGCircleElement>();
    const annotations = new Map<string, SVGGElement>();
    const neighbors = new Map<string, Set<string>>();
    for (const edge of edges) {
      if (!neighbors.has(edge.source)) neighbors.set(edge.source, new Set());
      if (!neighbors.has(edge.target)) neighbors.set(edge.target, new Set());
      neighbors.get(edge.source)!.add(edge.target);
      neighbors.get(edge.target)!.add(edge.source);
    }
    nodes.forEach((node) => {
      const { x, y } = positions.get(node.id)!;
      positions.set(node.id, { x, y });
      const link = document.createElementNS("http://www.w3.org/2000/svg", "a");
      link.setAttribute("data-node-id", node.id);
      if (node.href) link.setAttribute("href", node.href);
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", String(x)); circle.setAttribute("cy", String(y)); circle.setAttribute("r", String(NODE_RADIUS));
      circle.setAttribute("class", graphNodeClass(node));
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", String(x)); text.setAttribute("y", String(y + 4)); text.setAttribute("text-anchor", "middle");
      text.textContent = node.label.length > 16 ? `${node.label.slice(0, 14)}…` : node.label;
      const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
      const dateNote = node.dueDate ? ` · Due ${node.dueDate}` : " · No date";
      title.textContent = `${node.label}: ${node.title}${dateNote}`;
      link.append(circle, text, title); nodeLayer.append(link);
      nodeCircles.set(node.id, circle);

      const annotation = createAnnotation(node, x, y);
      annotationLayer.append(annotation);
      annotations.set(node.id, annotation);
    });
    const layout = routeDependencyEdges(
      [...positions].map(([id, position]) => ({ id, ...position })),
      edges,
    );
    const edgePaths: SVGPathElement[] = [];
    layout.routes.forEach((route) => {
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", route.d);
      path.setAttribute("class", "graph-edge");
      path.setAttribute("data-source", route.source);
      path.setAttribute("data-target", route.target);
      path.setAttribute("marker-end", "url(#arrowhead)");
      edgeLayer.append(path);
      edgePaths.push(path);
    });
    const annotationTop = nodes.length
      ? Math.min(...nodes.map((node) => positions.get(node.id)!.y - NODE_RADIUS - ANNOTATION_GAP - ANNOTATION_HEIGHT - 8))
      : layout.minY;
    const minY = Math.min(layout.minY, annotationTop);
    const maxY = layout.maxY;
    svg.setAttribute("viewBox", `0 ${minY} ${nodeLayout.width} ${maxY - minY}`);

    const clearHighlight = () => {
      for (const circle of nodeCircles.values()) {
        circle.classList.remove("graph-node--active", "graph-node--related");
      }
      for (const path of edgePaths) path.classList.remove("graph-edge--active");
      for (const annotation of annotations.values()) annotation.classList.remove("graph-annotation--visible");
    };
    const highlightNode = (id: string) => {
      clearHighlight();
      nodeCircles.get(id)?.classList.add("graph-node--active");
      annotations.get(id)?.classList.add("graph-annotation--visible");
      for (const neighborId of neighbors.get(id) ?? []) {
        nodeCircles.get(neighborId)?.classList.add("graph-node--related");
        annotations.get(neighborId)?.classList.add("graph-annotation--visible");
      }
      for (const path of edgePaths) {
        if (path.dataset.source === id || path.dataset.target === id) {
          path.classList.add("graph-edge--active");
        }
      }
    };
    for (const [id, circle] of nodeCircles) {
      const host = circle.parentElement;
      host?.addEventListener("pointerenter", () => highlightNode(id));
      host?.addEventListener("pointerleave", clearHighlight);
    }
  }
  document.querySelectorAll<HTMLElement>("[data-graph]").forEach((root) => {
    renderGraph(root);
    const projectFilter = root.querySelector<HTMLSelectElement>("[data-graph-project]");
    const doneToggle = root.querySelector<HTMLButtonElement>("[data-show-done]");
    const doneLabel = doneToggle?.querySelector<HTMLElement>("[data-done-label]");
    const setDoneVisibility = (visible: boolean) => {
      doneToggle?.setAttribute("aria-pressed", String(visible));
      if (doneLabel) doneLabel.textContent = visible ? "Hide Done" : "Show Done";
    };
    projectFilter?.addEventListener("change", () => renderGraph(root));
    doneToggle?.addEventListener("click", () => {
      setDoneVisibility(doneToggle.getAttribute("aria-pressed") !== "true");
      renderGraph(root);
    });
    root.querySelector<HTMLButtonElement>("[data-reset-graph]")?.addEventListener("click", () => {
      if (projectFilter) projectFilter.value = "";
      setDoneVisibility(true);
      renderGraph(root);
    });
  });
</script>
