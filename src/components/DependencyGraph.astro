---
import type { PublicSnapshot } from "../lib/schema";
import { layoutDependencyGraph, type DependencyGraphLayout } from "../lib/dependency-layout";
import { dependencyViewKey, filterDependencyView, type DependencyViewMode } from "../lib/dependency-view";
import {
  blockingRelations,
  compareDependencyIssues,
  dependencyCycles,
  dependencyIssueDate,
  initiativeProjects,
  issueHref,
  serializeForScript,
} from "../lib/view";

interface Props { snapshot: PublicSnapshot }
const { snapshot } = Astro.props;
const projects = initiativeProjects(snapshot);
const relations = blockingRelations(snapshot);
const endpointIds = [...new Set([
  ...Object.keys(snapshot.issues),
  ...relations.flatMap((relation) => [relation.sourceId, relation.targetId]),
])]
  .sort((a, b) => compareDependencyIssues(a, b, snapshot));
const nodes = endpointIds.map((id) => ({
  id,
  label: snapshot.issues[id]?.identifier ?? snapshot.boundaries[id]?.label ?? "Unknown",
  title: snapshot.issues[id]?.title ?? "Dependency outside this initiative",
  dueDate: dependencyIssueDate(id, snapshot),
  statusType: snapshot.issues[id]?.state.type ?? null,
  href: snapshot.issues[id] ? issueHref(snapshot.issues[id]) : null,
  projectId: snapshot.issues[id]?.projectId ?? null,
}));
const edges = relations.map((relation) => ({ source: relation.sourceId, target: relation.targetId }));
const layouts: Record<string, DependencyGraphLayout> = {};
const modes: DependencyViewMode[] = ["all", "dependent", "inflight"];
for (const mode of modes) {
  const view = filterDependencyView(nodes, edges, mode);
  layouts[dependencyViewKey(mode)] = layoutDependencyGraph(
    view.nodes.map((node) => ({ id: node.id, dateKey: node.dueDate })),
    view.edges,
  );
}
const graphData = serializeForScript({ nodes, edges, layouts });
const cycles = dependencyCycles(snapshot);
---

{cycles.length > 0 && (
  <aside class="alert" role="alert">
    <strong>{cycles.length} dependency cycle{cycles.length === 1 ? "" : "s"} detected.</strong>
    Review the relationships in the table below.
  </aside>
)}

<div class="graph-shell" data-graph>
  <div class="toolbar">
    <label>Project
      <select data-graph-project>
        <option value="">All projects</option>
        {projects.map((project) => <option value={project.id}>{project.name}</option>)}
      </select>
    </label>
    <label>Tasks
      <select data-graph-view>
        <option value="all">All tasks</option>
        <option value="dependent" selected>Dependent tasks</option>
        <option value="inflight">Inflight tasks</option>
      </select>
    </label>
    <div class="graph-zoom-controls" role="group" aria-label="Graph zoom controls">
      <button type="button" aria-label="Zoom out" data-zoom-out>−</button>
      <output aria-live="polite" aria-label="Current zoom" data-zoom-level>100%</output>
      <button type="button" aria-label="Zoom in" data-zoom-in>+</button>
      <button type="button" data-fit-graph>Fit</button>
    </div>
    <button class="button button--secondary" type="button" data-reset-graph>Reset view</button>
  </div>
  <p class="graph-help" id="dependency-graph-help">Scroll or pinch to zoom. Drag to pan. On touch, tap a node to inspect it, then use Open task. Use +, −, arrow keys, or 0 when the graph is focused.</p>
  <svg class="dependency-graph" viewBox="0 0 1000 600" role="img" aria-label="Blocking task dependency graph" aria-describedby="dependency-graph-help" tabindex="0" data-graph-svg>
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,4 L0,8 Z"></path></marker>
    </defs>
    <g data-edges></g>
    <g data-nodes></g>
    <g data-annotations></g>
  </svg>
  <p class="empty-state graph-empty" data-graph-empty hidden></p>
  <script is:inline type="application/json" data-graph-data set:html={graphData}></script>
</div>

<script>
  import {
    clientPanToGraphDelta,
    graphZoom,
    panGraphCamera,
    zoomGraphCamera,
    type GraphViewBox,
  } from "../lib/dependency-camera";
  import type { DependencyGraphLayout } from "../lib/dependency-layout";
  import {
    dependencyEdgeCrossesProject,
    dependencyEdgeTouchesProject,
    dependencyNodeMatchesProject,
    dependencyViewKey,
    filterDependencyView,
    type DependencyViewMode,
  } from "../lib/dependency-view";

  interface GraphNode {
    id: string;
    label: string;
    title: string;
    dueDate: string | null;
    statusType: string | null;
    href: string | null;
    projectId: string | null;
  }
  interface GraphEdge { source: string; target: string }
  interface GraphData {
    nodes: GraphNode[];
    edges: GraphEdge[];
    layouts: Record<string, DependencyGraphLayout>;
  }
  interface GraphCamera {
    fit: (base?: GraphViewBox) => void;
    zoomBy: (factor: number) => void;
    setTouchTapHandler: (handler: (nodeId: string | null) => void) => void;
  }
  interface GraphRenderController { applyProjectFocus: () => void }

  const NODE_RADIUS = 28;
  const ANNOTATION_HEIGHT = 38;
  const SELECTED_ANNOTATION_HEIGHT = 56;
  const ANNOTATION_GAP = 10;

  function truncateLabel(value: string, max: number): string {
    return value.length > max ? `${value.slice(0, max - 1)}…` : value;
  }

  /** Map Linear workflow type → graph fill (Todo blue, active green, Done grey). */
  function graphNodeClass(node: GraphNode): string {
    if (!node.href) return "graph-node graph-node--boundary";
    const type = (node.statusType ?? "").toLowerCase();
    if (type === "completed" || type === "canceled") return "graph-node graph-node--done";
    if (type === "started") return "graph-node graph-node--started";
    if (type === "unstarted" || type === "backlog" || type === "triage") return "graph-node graph-node--todo";
    return "graph-node graph-node--started";
  }

  function createAnnotation(node: GraphNode, x: number, y: number): SVGGElement {
    const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
    group.setAttribute("class", "graph-annotation");
    group.setAttribute("data-annotation-for", node.id);

    const titleLine = truncateLabel(node.title, 44);
    const dateLine = node.dueDate ? `Due ${node.dueDate}` : "No date";
    const width = Math.min(240, Math.max(112, Math.max(titleLine.length, dateLine.length) * 6.1 + 18));
    const cardY = y - NODE_RADIUS - ANNOTATION_GAP - ANNOTATION_HEIGHT;
    const cardX = x - width / 2;

    const card = document.createElementNS("http://www.w3.org/2000/svg", "rect");
    card.setAttribute("class", "graph-annotation__card");
    card.setAttribute("x", String(cardX));
    card.setAttribute("y", String(cardY));
    card.setAttribute("width", String(width));
    card.setAttribute("height", String(ANNOTATION_HEIGHT));
    card.setAttribute("rx", "6");

    const titleText = document.createElementNS("http://www.w3.org/2000/svg", "text");
    titleText.setAttribute("class", "graph-annotation__title");
    titleText.setAttribute("x", String(x));
    titleText.setAttribute("y", String(cardY + 15));
    titleText.setAttribute("text-anchor", "middle");
    titleText.textContent = titleLine;

    const dateText = document.createElementNS("http://www.w3.org/2000/svg", "text");
    dateText.setAttribute("class", "graph-annotation__date");
    dateText.setAttribute("x", String(x));
    dateText.setAttribute("y", String(cardY + 29));
    dateText.setAttribute("text-anchor", "middle");
    dateText.textContent = dateLine;

    group.append(card, titleText, dateText);
    if (node.href) {
      const openLink = document.createElementNS("http://www.w3.org/2000/svg", "a");
      openLink.setAttribute("class", "graph-annotation__open");
      openLink.setAttribute("href", node.href);
      openLink.setAttribute("aria-label", `Open ${node.label}: ${node.title}`);
      openLink.setAttribute("data-open-issue", "");

      const openHitArea = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      openHitArea.setAttribute("x", String(x - 39));
      openHitArea.setAttribute("y", String(cardY + 17));
      openHitArea.setAttribute("width", "78");
      openHitArea.setAttribute("height", "17");
      openHitArea.setAttribute("rx", "3");

      const openText = document.createElementNS("http://www.w3.org/2000/svg", "text");
      openText.setAttribute("x", String(x));
      openText.setAttribute("y", String(cardY + 29));
      openText.setAttribute("text-anchor", "middle");
      openText.textContent = "Open task →";
      openLink.append(openHitArea, openText);
      group.append(openLink);
    }
    return group;
  }

  function setAnnotationSelected(annotation: SVGGElement, selected: boolean): void {
    annotation.classList.toggle("graph-annotation--selected", selected);
    const card = annotation.querySelector<SVGRectElement>(".graph-annotation__card");
    const title = annotation.querySelector<SVGTextElement>(".graph-annotation__title");
    const date = annotation.querySelector<SVGTextElement>(".graph-annotation__date");
    const offset = selected ? SELECTED_ANNOTATION_HEIGHT - ANNOTATION_HEIGHT : 0;
    if (card) {
      const normalY = Number(card.dataset.normalY ?? card.getAttribute("y"));
      card.dataset.normalY = String(normalY);
      card.setAttribute("y", String(normalY - offset));
      card.setAttribute("height", String(selected ? SELECTED_ANNOTATION_HEIGHT : ANNOTATION_HEIGHT));
    }
    for (const text of [title, date]) {
      if (!text) continue;
      const normalY = Number(text.dataset.normalY ?? text.getAttribute("y"));
      text.dataset.normalY = String(normalY);
      text.setAttribute("y", String(normalY - offset));
    }
  }

  function createGraphCamera(root: HTMLElement): GraphCamera {
    const svg = root.querySelector<SVGSVGElement>("[data-graph-svg]")!;
    const zoomLevel = root.querySelector<HTMLOutputElement>("[data-zoom-level]");
    const zoomOut = root.querySelector<HTMLButtonElement>("[data-zoom-out]");
    const zoomIn = root.querySelector<HTMLButtonElement>("[data-zoom-in]");
    const maxZoom = window.matchMedia("(pointer: coarse)").matches ? 8 : 4;
    let base: GraphViewBox = { x: 0, y: 0, width: 1000, height: 600 };
    let camera: GraphViewBox = { ...base };
    let suppressClickUntil = 0;
    let dragged = false;
    let touchTapHandler: (nodeId: string | null) => void = () => {};
    let tapCandidate: { pointerId: number; nodeId: string | null } | null = null;
    const pointers = new Map<number, { x: number; y: number }>();
    let gesture: {
      points: Map<number, { x: number; y: number }>;
      camera: GraphViewBox;
      distance: number;
      midpoint: { x: number; y: number };
      anchor: { x: number; y: number };
    } | null = null;

    const apply = (next: GraphViewBox) => {
      camera = next;
      svg.setAttribute("viewBox", `${camera.x} ${camera.y} ${camera.width} ${camera.height}`);
      const zoom = graphZoom(base, camera);
      if (zoomLevel) zoomLevel.value = `${Math.round(zoom * 100)}%`;
      if (zoomOut) zoomOut.disabled = zoom <= 1.001;
      if (zoomIn) zoomIn.disabled = zoom >= maxZoom - 0.001;
    };
    const clientPointToGraph = (x: number, y: number) => {
      const point = svg.createSVGPoint();
      point.x = x;
      point.y = y;
      const matrix = svg.getScreenCTM();
      if (!matrix) return { x: camera.x + camera.width / 2, y: camera.y + camera.height / 2 };
      const graphPoint = point.matrixTransform(matrix.inverse());
      return { x: graphPoint.x, y: graphPoint.y };
    };
    const midpoint = (points: Array<{ x: number; y: number }>) => ({
      x: points.reduce((sum, point) => sum + point.x, 0) / points.length,
      y: points.reduce((sum, point) => sum + point.y, 0) / points.length,
    });
    const distance = (points: Array<{ x: number; y: number }>) => points.length < 2
      ? 0
      : Math.hypot(points[1].x - points[0].x, points[1].y - points[0].y);
    const beginGesture = () => {
      if (!pointers.size) {
        gesture = null;
        return;
      }
      const points = [...pointers.values()].slice(0, 2);
      const middle = midpoint(points);
      gesture = {
        points: new Map(pointers),
        camera: { ...camera },
        distance: distance(points),
        midpoint: middle,
        anchor: clientPointToGraph(middle.x, middle.y),
      };
    };
    const viewport = () => {
      const rect = svg.getBoundingClientRect();
      return { width: rect.width, height: rect.height };
    };
    const fit = (nextBase?: GraphViewBox) => {
      if (nextBase) base = { ...nextBase };
      apply({ ...base });
    };
    const zoomBy = (factor: number, anchor?: { x: number; y: number }) => {
      apply(zoomGraphCamera(base, camera, graphZoom(base, camera) * factor, anchor, maxZoom));
    };

    zoomOut?.addEventListener("click", () => zoomBy(1 / 1.35));
    zoomIn?.addEventListener("click", () => zoomBy(1.35));
    root.querySelector<HTMLButtonElement>("[data-fit-graph]")?.addEventListener("click", () => fit());
    svg.addEventListener("wheel", (event) => {
      event.preventDefault();
      const delta = event.deltaY * (event.deltaMode === WheelEvent.DOM_DELTA_LINE
        ? 16
        : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? svg.clientHeight : 1);
      zoomBy(Math.exp(-delta * 0.002), clientPointToGraph(event.clientX, event.clientY));
    }, { passive: false });
    svg.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("[data-open-issue]")) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      svg.setPointerCapture(event.pointerId);
      dragged = false;
      if (event.pointerType === "touch" || event.pointerType === "pen") {
        const nodeHost = target?.closest<SVGAElement>("[data-node-id]");
        tapCandidate = pointers.size === 1
          ? { pointerId: event.pointerId, nodeId: nodeHost?.dataset.nodeId ?? null }
          : null;
      } else {
        tapCandidate = null;
      }
      beginGesture();
    });
    svg.addEventListener("pointermove", (event) => {
      if (!pointers.has(event.pointerId) || !gesture) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      const startPoints = [...gesture.points.values()].slice(0, 2);
      const currentPoints = [...pointers.values()].slice(0, 2);
      const startMiddle = gesture.midpoint;
      const currentMiddle = midpoint(currentPoints);
      const movement = Math.hypot(currentMiddle.x - startMiddle.x, currentMiddle.y - startMiddle.y);
      if (movement > 4 || currentPoints.length > 1) {
        dragged = true;
        tapCandidate = null;
        svg.classList.add("dependency-graph--panning");
      }
      if (currentPoints.length > 1 && startPoints.length > 1) {
        const ratio = gesture.distance ? distance(currentPoints) / gesture.distance : 1;
        const zoomed = zoomGraphCamera(
          base,
          gesture.camera,
          graphZoom(base, gesture.camera) * ratio,
          gesture.anchor,
          maxZoom,
        );
        const delta = clientPanToGraphDelta(
          zoomed,
          viewport(),
          currentMiddle.x - startMiddle.x,
          currentMiddle.y - startMiddle.y,
        );
        apply(panGraphCamera(base, zoomed, -delta.x, -delta.y, maxZoom));
      } else {
        const delta = clientPanToGraphDelta(
          gesture.camera,
          viewport(),
          currentMiddle.x - startMiddle.x,
          currentMiddle.y - startMiddle.y,
        );
        apply(panGraphCamera(base, gesture.camera, -delta.x, -delta.y, maxZoom));
      }
    });
    const endPointer = (event: PointerEvent) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.delete(event.pointerId);
      if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);
      if (dragged || tapCandidate?.pointerId === event.pointerId) {
        suppressClickUntil = performance.now() + 350;
      }
      if (!dragged && tapCandidate?.pointerId === event.pointerId) {
        touchTapHandler(tapCandidate.nodeId);
      }
      tapCandidate = null;
      svg.classList.remove("dependency-graph--panning");
      beginGesture();
    };
    svg.addEventListener("pointerup", endPointer);
    svg.addEventListener("pointercancel", endPointer);
    svg.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("[data-open-issue]")) return;
      if (performance.now() > suppressClickUntil) return;
      event.preventDefault();
      event.stopPropagation();
      suppressClickUntil = 0;
    }, true);
    svg.addEventListener("keydown", (event) => {
      if (event.target instanceof SVGAElement && (event.key === "Enter" || event.key === " ")) return;
      const panX = camera.width * 0.1;
      const panY = camera.height * 0.1;
      if (event.key === "+" || event.key === "=") zoomBy(1.35);
      else if (event.key === "-") zoomBy(1 / 1.35);
      else if (event.key === "0") fit();
      else if (event.key === "ArrowLeft") apply(panGraphCamera(base, camera, -panX, 0, maxZoom));
      else if (event.key === "ArrowRight") apply(panGraphCamera(base, camera, panX, 0, maxZoom));
      else if (event.key === "ArrowUp") apply(panGraphCamera(base, camera, 0, -panY, maxZoom));
      else if (event.key === "ArrowDown") apply(panGraphCamera(base, camera, 0, panY, maxZoom));
      else return;
      event.preventDefault();
    });

    return {
      fit,
      zoomBy,
      setTouchTapHandler: (handler) => { touchTapHandler = handler; },
    };
  }

  function renderGraph(root: HTMLElement, camera: GraphCamera): GraphRenderController | null {
    const dataNode = root.querySelector<HTMLScriptElement>("[data-graph-data]");
    const all = JSON.parse(dataNode?.textContent || "{}") as GraphData;
    const mode = (root.querySelector<HTMLSelectElement>("[data-graph-view]")?.value ?? "dependent") as DependencyViewMode;
    const { nodes, edges } = filterDependencyView(all.nodes, all.edges, mode);
    const svg = root.querySelector<SVGSVGElement>("[data-graph-svg]");
    const emptyState = root.querySelector<HTMLElement>("[data-graph-empty]");
    const nodeLayer = svg?.querySelector<SVGGElement>("[data-nodes]");
    const edgeLayer = svg?.querySelector<SVGGElement>("[data-edges]");
    const annotationLayer = svg?.querySelector<SVGGElement>("[data-annotations]");
    if (!svg || !nodeLayer || !edgeLayer || !annotationLayer) return null;
    svg.toggleAttribute("hidden", nodes.length === 0);
    if (emptyState) {
      emptyState.hidden = nodes.length !== 0;
      emptyState.textContent = mode === "all"
        ? "No tasks were found for this initiative."
        : mode === "dependent"
          ? "No dependent tasks were found for this initiative."
          : "No inflight dependency relationships were found for this initiative.";
    }
    nodeLayer.replaceChildren();
    edgeLayer.replaceChildren();
    annotationLayer.replaceChildren();
    const layout = all.layouts[dependencyViewKey(mode)];
    if (!layout) return null;
    const positions = new Map(layout.nodes.map(({ id, x, y }) => [id, { x, y }]));
    const nodesById = new Map(nodes.map((node) => [node.id, node]));
    const nodeCircles = new Map<string, SVGCircleElement>();
    const nodeHosts = new Map<string, SVGAElement>();
    const annotations = new Map<string, SVGGElement>();
    const neighbors = new Map<string, Set<string>>();
    for (const edge of edges) {
      if (!neighbors.has(edge.source)) neighbors.set(edge.source, new Set());
      if (!neighbors.has(edge.target)) neighbors.set(edge.target, new Set());
      neighbors.get(edge.source)!.add(edge.target);
      neighbors.get(edge.target)!.add(edge.source);
    }
    nodes.forEach((node) => {
      const { x, y } = positions.get(node.id)!;
      positions.set(node.id, { x, y });
      const link = document.createElementNS("http://www.w3.org/2000/svg", "a");
      link.setAttribute("data-node-id", node.id);
      link.setAttribute("aria-label", `${node.label}: ${node.title}. ${node.dueDate ? `Due ${node.dueDate}` : "No date"}`);
      if (node.href) link.setAttribute("href", node.href);
      else link.setAttribute("tabindex", "0");
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", String(x)); circle.setAttribute("cy", String(y)); circle.setAttribute("r", String(NODE_RADIUS));
      circle.setAttribute("class", graphNodeClass(node));
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", String(x)); text.setAttribute("y", String(y + 4)); text.setAttribute("text-anchor", "middle");
      text.textContent = node.label.length > 16 ? `${node.label.slice(0, 14)}…` : node.label;
      link.append(circle, text); nodeLayer.append(link);
      nodeCircles.set(node.id, circle);
      nodeHosts.set(node.id, link);

      const annotation = createAnnotation(node, x, y);
      annotationLayer.append(annotation);
      annotations.set(node.id, annotation);
    });
    const edgePaths: SVGPathElement[] = [];
    layout.routes.forEach((route) => {
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", route.d);
      path.setAttribute("class", "graph-edge");
      path.setAttribute("data-source", route.source);
      path.setAttribute("data-target", route.target);
      path.setAttribute("marker-end", "url(#arrowhead)");
      edgeLayer.append(path);
      edgePaths.push(path);
    });
    const annotationTop = nodes.length
      ? Math.min(...nodes.map((node) => positions.get(node.id)!.y - NODE_RADIUS - ANNOTATION_GAP - SELECTED_ANNOTATION_HEIGHT - 8))
      : layout.minY;
    const minY = Math.min(layout.minY, annotationTop);
    const maxY = layout.maxY;
    camera.fit({ x: 0, y: minY, width: layout.width, height: maxY - minY });

    let selectedId: string | null = null;
    const isProjectNodeActive = (id: string) => {
      const selectedProject = root.querySelector<HTMLSelectElement>("[data-graph-project]")?.value ?? "";
      const node = nodesById.get(id);
      return node ? dependencyNodeMatchesProject(node, selectedProject) : false;
    };
    const clearHighlight = () => {
      for (const circle of nodeCircles.values()) {
        circle.classList.remove("graph-node--active", "graph-node--related");
      }
      for (const host of nodeHosts.values()) host.classList.remove("graph-node-host--revealed");
      for (const path of edgePaths) path.classList.remove("graph-edge--active");
      for (const annotation of annotations.values()) {
        annotation.classList.remove("graph-annotation--visible");
        setAnnotationSelected(annotation, false);
      }
    };
    const highlightNode = (id: string, persistent = false) => {
      if (!isProjectNodeActive(id)) return;
      clearHighlight();
      nodeCircles.get(id)?.classList.add("graph-node--active");
      const annotation = annotations.get(id);
      annotation?.classList.add("graph-annotation--visible");
      if (annotation) {
        setAnnotationSelected(annotation, persistent);
        if (persistent) annotationLayer.append(annotation);
      }
      for (const neighborId of neighbors.get(id) ?? []) {
        nodeCircles.get(neighborId)?.classList.add("graph-node--related");
        nodeHosts.get(neighborId)?.classList.add("graph-node-host--revealed");
        annotations.get(neighborId)?.classList.add("graph-annotation--visible");
      }
      for (const path of edgePaths) {
        if (path.dataset.source === id || path.dataset.target === id) {
          path.classList.add("graph-edge--active");
        }
      }
    };
    const restoreSelection = () => {
      if (selectedId && nodeCircles.has(selectedId)) highlightNode(selectedId, true);
      else clearHighlight();
    };
    camera.setTouchTapHandler((id) => {
      selectedId = id && nodeCircles.has(id) && isProjectNodeActive(id) ? id : null;
      restoreSelection();
    });
    for (const [id, circle] of nodeCircles) {
      const host = circle.parentElement;
      host?.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse" && isProjectNodeActive(id)) highlightNode(id);
      });
      host?.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "mouse") restoreSelection();
      });
      host?.addEventListener("focus", () => {
        if (isProjectNodeActive(id)) highlightNode(id, selectedId === id);
      });
      host?.addEventListener("blur", restoreSelection);
    }
    const applyProjectFocus = () => {
      const selectedProject = root.querySelector<HTMLSelectElement>("[data-graph-project]")?.value ?? "";
      for (const [id, host] of nodeHosts) {
        host.classList.toggle("graph-node-host--dimmed", !isProjectNodeActive(id));
      }
      for (const path of edgePaths) {
        const edge = { source: path.dataset.source!, target: path.dataset.target! };
        path.classList.toggle("graph-edge--dimmed", !dependencyEdgeTouchesProject(edge, nodesById, selectedProject));
        path.classList.toggle("graph-edge--cross-project", dependencyEdgeCrossesProject(edge, nodesById, selectedProject));
      }
      if (selectedId && !isProjectNodeActive(selectedId)) selectedId = null;
      restoreSelection();
    };
    applyProjectFocus();
    return { applyProjectFocus };
  }
  document.querySelectorAll<HTMLElement>("[data-graph]").forEach((root) => {
    const camera = createGraphCamera(root);
    let graph = renderGraph(root, camera);
    const projectFilter = root.querySelector<HTMLSelectElement>("[data-graph-project]");
    const viewFilter = root.querySelector<HTMLSelectElement>("[data-graph-view]");
    projectFilter?.addEventListener("change", () => graph?.applyProjectFocus());
    viewFilter?.addEventListener("change", () => { graph = renderGraph(root, camera); });
    root.querySelector<HTMLButtonElement>("[data-reset-graph]")?.addEventListener("click", () => {
      if (projectFilter) projectFilter.value = "";
      if (viewFilter) viewFilter.value = "dependent";
      graph = renderGraph(root, camera);
    });
  });
</script>
