---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import IssueTree from "../../components/IssueTree.astro";
import ResourceList from "../../components/ResourceList.astro";
import { readSnapshot } from "../../lib/snapshot";
import { formatDate, formatDateTime, issueRoots, statusClass } from "../../lib/view";

export const getStaticPaths = (async () => {
  const snapshot = await readSnapshot();
  return Object.values(snapshot.projects).map((project) => ({ params: { id: project.id }, props: { project, snapshot } }));
}) satisfies GetStaticPaths;

const { project, snapshot } = Astro.props;
const projectIssues = project.issueIds.map((id: string) => snapshot.issues[id]).filter(Boolean);
const roots = issueRoots(project, snapshot);
---
<BaseLayout title={`${project.name} · ${snapshot.initiative.name}`} description={project.summary} generatedAt={snapshot.generatedAt}>
  <header class="page-header project-header">
    <a class="back-link" href="/">← Initiative</a>
    <div class="hero-heading"><div><span class="eyebrow">Project</span><h1>{project.name}</h1>{project.summary && <p>{project.summary}</p>}</div><a class="button" href={project.url} target="_blank" rel="noopener noreferrer">Open in Linear ↗</a></div>
    <div class="hero-meta"><span class={statusClass(project.status.type)}>{project.status.name}</span><span>{formatDate(project.startDate)} → {formatDate(project.targetDate)}</span>{project.lead && <span>Lead: {project.lead.name}</span>}</div>
  </header>
  {project.descriptionHtml && <section class="content-section prose"><div class="section-heading"><h2>Overview</h2></div><div set:html={project.descriptionHtml}></div></section>}
  {project.resources.length > 0 && <section class="content-section"><div class="section-heading"><div><span class="eyebrow">References</span><h2>Resources</h2></div></div><ResourceList resources={project.resources} snapshot={snapshot} /></section>}
  {project.latestUpdate && <section class="content-section update-card"><div class="section-heading"><div><span class="eyebrow">Latest update</span><h2>Project status</h2></div><time datetime={project.latestUpdate.createdAt}>{formatDateTime(project.latestUpdate.createdAt)}</time></div><div class="prose" set:html={project.latestUpdate.bodyHtml}></div><p class="update-author">{project.latestUpdate.user.name} · {project.latestUpdate.health}</p></section>}
  {project.milestones.length > 0 && <section class="content-section"><div class="section-heading"><h2>Milestones</h2></div><ol class="milestone-list">{project.milestones.map((milestone: any) => <li><span class="milestone-dot"></span><div><strong>{milestone.name}</strong><time datetime={milestone.targetDate || undefined}>{formatDate(milestone.targetDate)}</time>{milestone.descriptionHtml && <div class="prose compact" set:html={milestone.descriptionHtml}></div>}</div></li>)}</ol></section>}
  <section class="content-section"><div class="section-heading"><div><span class="eyebrow">Work breakdown</span><h2>Tasks</h2></div><span>{projectIssues.length} total</span></div>{roots.length ? <IssueTree issues={roots} snapshot={snapshot} orderBy="dueDate" /> : <p class="empty-state">No tasks in this project.</p>}</section>
</BaseLayout>
