{
  "name": "linear-initiative-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cached": "LINEAR_SKIP_SYNC=1 astro build",
    "deploy": "wrangler deploy",
    "deploy:rebuild": "npm run build && npm run deploy",
    "preview": "astro preview",
    "sync": "tsx scripts/sync.ts",
    "pull:document": "tsx scripts/pull-linear-document.ts",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "dotenv": "^18.0.3",
    "marked": "^18.0.14",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "^2.16.1",
    "graphql": "^17.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
